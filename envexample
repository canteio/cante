# Local app
CANTE_APP_URL=http://localhost:3000

# Auth
# demo = local demo/demo cookie gate
# supabase = Supabase email/password auth via @supabase/ssr
CANTE_AUTH_MODE=demo
NEXT_PUBLIC_CANTE_AUTH_MODE=demo

# Supabase auth + production data
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
CANTE_DATA_BACKEND=sqlite
# Local sync worker only. Never add this to Vercel or expose it as NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=
CANTE_SUPABASE_CUSTOMER_SLUG=example-company
CANTE_SYNC_SUPABASE=false

# LLM provider
# Local: claude-code / codex-cli / antigravity. Vercel: api.
CANTE_LLM=claude-code
CANTE_LLM_LOCKED=false
CLAUDE_BIN=
CODEX_BIN=
GEMINI_API_KEY=
GOOGLE_API_KEY=
# Hosted production provider. Set one key, server-side only.
CANTE_HOSTED_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
CANTE_LLM_MAX_OUTPUT_TOKENS=16000

# SQLite, local runner, and local development
CANTE_DB_PATH=

# Scheduled delivery / operator alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CANTE_HEARTBEAT_URL=

# Import monitoring: scheduled on the trusted worker, scoped to one workspace.
# Uses CANTE_DATA_BACKEND (sqlite or supabase). Supabase requires the existing
# worker-only SUPABASE_SECRET_KEY; never put that secret in Vercel/client env.
CANTE_IMPORT_CUSTOMER_ID=
# Absolute path to an authorized normalized export (see pipeline README).
# Unset means explicitly blocked; sample_fixture rows never produce leads.
CANTE_IMPORT_SHIPMENTS_FILE=
# Optional local CAMIR header inspection, separate from normalized ingestion.
CANTE_CAMIR_FILE=
